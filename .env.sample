# Central environment & version configuration for GKE Sandbox microVM + ARC DinD
export PROJECT_ID="${PROJECT_ID:-sample}"
export REGION="${REGION:-asia-southeast1}"
export ZONE="${ZONE:-asia-southeast1-b}"
export CLUSTER_NAME="${CLUSTER_NAME:-arc-nested-virt-demo}"
export NETWORK_NAME="${NETWORK_NAME:-${CLUSTER_NAME}-vpc}"
export SUBNET_NAME="${SUBNET_NAME:-${CLUSTER_NAME}-subnet}"
export NODE_SA_NAME="${NODE_SA_NAME:-${CLUSTER_NAME}-nodes}"

# GKE version & channel (GKE Sandbox microvm GA requires 1.37.0-gke.4713000+)
export GKE_RELEASE_CHANNEL="${GKE_RELEASE_CHANNEL:-regular}"
export GKE_CLUSTER_VERSION="${GKE_CLUSTER_VERSION:-1.37.1-gke.1552000}"

# Node pool machine types
export SYSTEM_MACHINE_TYPE="${SYSTEM_MACHINE_TYPE:-e2-standard-4}"
export MICROVM_MACHINE_TYPE="${MICROVM_MACHINE_TYPE:-n2-standard-8}"

# GitHub target configuration
export GITHUB_ORG="${GITHUB_ORG:-sample}"
export GITHUB_REPO="${GITHUB_REPO:-sample-repo}"
export GITHUB_CONFIG_URL="${GITHUB_CONFIG_URL:-https://github.com/${GITHUB_ORG}/${GITHUB_REPO}}"

# Actions Runner Controller (ARC) OCI Helm chart version & image pins
export ARC_CHART_VERSION="${ARC_CHART_VERSION:-0.15.1}"
export ARC_RUNNER_IMAGE="${ARC_RUNNER_IMAGE:-ghcr.io/actions/actions-runner:2.338.1}"
export DIND_IMAGE="${DIND_IMAGE:-docker:29.9-dind}"

# Kubernetes namespaces & Helm release names
export ARC_CONTROLLER_NAMESPACE="arc-systems"
export ARC_CONTROLLER_RELEASE="arc"

export ARC_RUNNER_NAMESPACE="arc-runners"
export ARC_RUNNER_RELEASE="arc-dind-microvm"

export GITHUB_SECRET_NAME="arc-github-app"
